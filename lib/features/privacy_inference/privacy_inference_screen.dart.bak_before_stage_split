class _PrivacyResultCard extends StatelessWidget {
  const _PrivacyResultCard({
    required this.studyResult,
    required this.ratings,
    required this.shareConsent,
    required this.onChanged,
  });

  final PrivacyStudyResult studyResult;
  final Map<String, Map<String, int>> ratings;
  final Map<String, bool?> shareConsent;
  final VoidCallback onChanged;

  @override
  Widget build(BuildContext context) {
    final result = studyResult.result;
    final String key = studyResult.file.id;
    final Object? raw = result.rawOutput;
    final Map<String, dynamic> json =
        raw is Map<String, dynamic> ? raw : <String, dynamic>{};
    return Card(
      margin: const EdgeInsets.only(bottom: 16),
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: <Widget>[
            Row(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: <Widget>[
                _FileThumbnail(
                  file: studyResult.file,
                  onTap: () => Navigator.of(context).push(
                    MaterialPageRoute<void>(
                      builder: (_) =>
                          _FilePreviewScreen(file: studyResult.file),
                    ),
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: <Widget>[
                      Text(studyResult.file.originalName,
                          style: Theme.of(context).textTheme.titleMedium),
                      Text(studyResult.file.note,
                          style: Theme.of(context).textTheme.bodySmall),
                    ],
                  ),
                ),
              ],
            ),
            const SizedBox(height: 8),
            if (result.failure != null)
              Text('Inference failed: ${result.failure!.message}',
                  style: const TextStyle(color: Colors.red))
            else ...<Widget>[
              _InfoLine(
                  label: 'Sensitivity',
                  value: result.prediction?.label ?? 'unknown'),
              _InfoLine(
                  label: 'Latency', value: '${result.metadata.latencyMs} ms'),
              const SizedBox(height: 8),
              Text(
                _stringValue(json['user_visible_message']) ??
                    _stringValue(json['summary']) ??
                    'No user-visible summary returned.',
              ),
              const SizedBox(height: 8),
              _StringList(
                  title: 'Why this file may be on the phone',
                  value: json['why_on_phone']),
              _StringList(
                  title: 'Inferred context', value: json['inferred_context']),
              _StringList(
                  title: 'Sensitive clues', value: json['sensitive_clues']),
              _TraitsList(value: json['possible_traits']),
              const Divider(height: 28),
              Text('Post-inference questions',
                  style: Theme.of(context).textTheme.titleSmall),
              _RatingQuestion(
                resultKey: key,
                ratings: ratings,
                id: 'surprise',
                label: 'How surprising was this inference?',
                onChanged: onChanged,
              ),
              _RatingQuestion(
                resultKey: key,
                ratings: ratings,
                id: 'aha_effect',
                label:
                    'How strongly did this make you think about what phone AI could learn over time?',
                onChanged: onChanged,
              ),
              _RatingQuestion(
                resultKey: key,
                ratings: ratings,
                id: 'sensitivity',
                label: 'How sensitive does this inference feel?',
                onChanged: onChanged,
              ),
              _RatingQuestion(
                resultKey: key,
                ratings: ratings,
                id: 'accuracy',
                label: 'How accurate does this inference seem?',
                onChanged: onChanged,
              ),
              const SizedBox(height: 8),
              const Text(
                'Would you allow sending this summarized inference, not the raw file, to the research server?',
              ),
              Wrap(
                spacing: 8,
                children: <Widget>[
                  ChoiceChip(
                    label: const Text('Yes'),
                    selected: shareConsent[key] == true,
                    onSelected: (_) {
                      shareConsent[key] = true;
                      onChanged();
                    },
                  ),
                  ChoiceChip(
                    label: const Text('No'),
                    selected: shareConsent[key] == false,
                    onSelected: (_) {
                      shareConsent[key] = false;
                      onChanged();
                    },
                  ),
                ],
              ),
              ExpansionTile(
                title: const Text('Raw structured output'),
                children: <Widget>[
                  Padding(
                    padding: const EdgeInsets.all(8),
                    child: SelectableText(
                        const JsonEncoder.withIndent('  ').convert(raw)),
                  ),
                ],
              ),
            ],
          ],
        ),
      ),
    );
  }

  String? _stringValue(Object? value) => value is String ? value : null;
}

class _InfoLine extends StatelessWidget {
  const _InfoLine({required this.label, required this.value});

  final String label;
  final String value;

  @override
  Widget build(BuildContext context) {
    return Text('$label: $value');
  }
}

class _StringList extends StatelessWidget {
  const _StringList({required this.title, required this.value});

  final String title;
  final Object? value;

  @override
  Widget build(BuildContext context) {
    final Object? rawValue = value;
    if (rawValue is! List || rawValue.isEmpty) {
      return const SizedBox.shrink();
    }
    final List list = rawValue;
    return Padding(
      padding: const EdgeInsets.only(top: 8),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: <Widget>[
          Text(title, style: Theme.of(context).textTheme.titleSmall),
          for (final Object? item in list) Text('• $item'),
        ],
      ),
    );
  }
}

class _TraitsList extends StatelessWidget {
  const _TraitsList({required this.value});

  final Object? value;

  @override
  Widget build(BuildContext context) {
    final Object? rawValue = value;
    if (rawValue is! List || rawValue.isEmpty) {
      return const SizedBox.shrink();
    }
    final List list = rawValue;
    return Padding(
      padding: const EdgeInsets.only(top: 8),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: <Widget>[
          Text('Possible traits',
              style: Theme.of(context).textTheme.titleSmall),
          for (final Object? item in list)
            if (item is Map)
              Text(
                  '• ${item['trait'] ?? 'trait'}: ${item['evidence'] ?? 'no evidence'} (${item['confidence'] ?? '?'})')
            else
              Text('• $item'),
        ],
      ),
    );
  }
}

class _RatingQuestion extends StatelessWidget {
  const _RatingQuestion({
    required this.resultKey,
    required this.ratings,
    required this.id,
    required this.label,
    required this.onChanged,
  });

  final String resultKey;
  final Map<String, Map<String, int>> ratings;
  final String id;
  final String label;
  final VoidCallback onChanged;

  @override
  Widget build(BuildContext context) {
    final int? current = ratings[resultKey]?[id];
    return Padding(
      padding: const EdgeInsets.only(top: 8),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: <Widget>[
          Text(label),
          Wrap(
            spacing: 6,
            children: <Widget>[
              for (int value = 1; value <= 5; value++)
                ChoiceChip(
                  label: Text('$value'),
                  selected: current == value,
                  onSelected: (_) {
                    ratings.putIfAbsent(resultKey, () => <String, int>{})[id] =
                        value;
                    onChanged();
                  },
                ),
            ],
          ),
        ],
      ),
    );
  }
}

class _FileThumbnail extends StatelessWidget {
  const _FileThumbnail({required this.file, required this.onTap});

  final PrivacyStudyFile file;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    final List<int>? bytes = file.analysisAsset.bytes;
    final Widget child;
    if (bytes == null || bytes.isEmpty) {
      child = const SizedBox(
        width: 72,
        height: 72,
        child: ColoredBox(
          color: Color(0xFFE8EFEC),
          child: Icon(Icons.insert_drive_file),
        ),
      );
    } else {
      child = ClipRRect(
        borderRadius: BorderRadius.circular(10),
        child: Image.memory(
          Uint8List.fromList(bytes),
          width: 72,
          height: 72,
          fit: BoxFit.cover,
        ),
      );
    }
    return InkWell(onTap: onTap, child: child);
  }
}

